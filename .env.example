# =============================================================================
# Licarl Prompt Maker - Environment Configuration
# =============================================================================

# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://licarl:licarl_secret@localhost:5432/licarl_prompt_maker?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (AES-256-GCM for API keys)
ENCRYPTION_KEY=change-me-32-byte-hex-or-base64-key-here!!

# Redis (optional, for rate limiting & sessions)
REDIS_URL=redis://localhost:6379

# Email (for verification, password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@licarl.prompt

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Frontend
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Storage (local or S3-compatible)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Feature Flags
ENABLE_MARKETPLACE=true
ENABLE_WORKFLOWS=true
ENABLE_AGENTS=true
ENABLE_2FA=true
